# Odometer Palindromes
# ============================================================

def is_palindrome(text):
    """Return True if text reads the same forward and backward."""

    return text == text[::-1]


def exercise_9_8():
    """
    Find six-digit numbers that satisfy the Car Talk
    odometer palindrome requirements.
    """

    print("\n")
    print("=" * 60)
    print("EXERCISE 9-8")
    print("Car Talk Odometer Puzzle")
    print("=" * 60)

    for number in range(100000, 1000000):

        # Convert the number to a string.
        odometer = str(number)

        # First reading:
        # Last 4 digits are a palindrome.
        condition_1 = is_palindrome(odometer[2:6])

        # One mile later:
        # Last 5 digits are a palindrome.
        condition_2 = is_palindrome(str(number + 1)[1:6])

        # Two miles later:
        # Middle 4 digits are a palindrome.
        condition_3 = is_palindrome(str(number + 2)[1:5])

        # Three miles later:
        # All 6 digits are a palindrome.
        condition_4 = is_palindrome(str(number + 3))

        if condition_1 and condition_2 and condition_3 and condition_4:
            print("Starting odometer reading:", number)
            print("One mile later:             ", number + 1)
            print("Two miles later:            ", number + 2)
            print("Three miles later:          ", number + 3)
            print()


