# Three Consecutive Double Letters
# ============================================================

def has_three_consecutive_doubles(word):
    """
    Return True if the word contains three consecutive
    pairs of the same letter.

    Example:
    bookkeeper -> oo kk ee
    """

    i = 0
    count = 0

    while i < len(word) - 1:

        if word[i] == word[i + 1]:
            count += 1
            i += 2

            if count == 3:
                return True
        else:
            count = 0
            i += 1

    return False


def exercise_9_7():
    """Find words with three consecutive pairs of letters."""

    try:
        fin = open("words.txt")

        print("=" * 60)
        print("EXERCISE 9-7")
        print("Words with three consecutive double letters")
        print("=" * 60)

        found = False

        for line in fin:
            word = line.strip()

            if has_three_consecutive_doubles(word):
                print(word)
                found = True

        fin.close()

        if not found:
            print("No matching words were found.")

    except FileNotFoundError:
        print("Error: words.txt was not found.")


