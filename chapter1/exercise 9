# Exercise 9-9
# Reversible Ages
# ============================================================

def reverse_age(age):
    """
    Reverse the digits of an age.

    zfill(2) ensures that ages such as 5 become '05'
    before reversing.
    """

    age_string = str(age).zfill(2)

    reversed_string = age_string[::-1]

    return int(reversed_string)


def count_reversible_ages(my_age, mother_age, years=100):
    """
    Count how many times the two ages are reverses
    of each other over the specified number of years.
    """

    count = 0

    for year in range(years):

        current_my_age = my_age + year
        current_mother_age = mother_age + year

        if reverse_age(current_my_age) == current_mother_age:
            count += 1

    return count


def exercise_9_9():
    """
    Search for possible current ages that satisfy
    the Car Talk reversible-age puzzle.
    """

    print("\n")
    print("=" * 60)
    print("EXERCISE 9-9")
    print("Car Talk Reversible Ages Puzzle")
    print("=" * 60)

    print("Possible solutions:")

    for my_age in range(10, 100):

        # Assume the mother is older.
        for age_difference in range(10, 51):

            mother_age = my_age + age_difference

            # Count reversible ages from the current age onward.
            count = count_reversible_ages(
                my_age,
                mother_age
            )

            # The puzzle says it has happened 6 times so far,
            # and could happen two more times.
            if count == 8:

                # Count how many times it has already happened.
                past_count = 0

                for years_ago in range(my_age):

                    past_my_age = my_age - years_ago
                    past_mother_age = mother_age - years_ago

                    if past_my_age >= 0 and past_mother_age >= 0:
                        if reverse_age(past_my_age) == past_mother_age:
                            past_count += 1

                if past_count == 6:
                    print(
                        "My age:",
                        my_age,
                        "| Mother's age:",
                        mother_age,
                        "| Reversible ages so far:",
                        past_count
                    )


