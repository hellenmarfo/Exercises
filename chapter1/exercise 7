# Square Root using Newton's Method
# ============================================================

def mysqrt(a):
    """Estimate the square root of a using Newton's method."""

    x = a / 2

    while True:
        y = (x + a / x) / 2

        if abs(y - x) < 1e-12:
            return y

        x = y


def test_square_root():
    """Print a table comparing mysqrt() with math.sqrt()."""

    import math

    print("a\tmysqrt(a)\tmath.sqrt(a)\tdiff")
    print("-" * 60)

    for a in range(1, 10):
        my_result = mysqrt(float(a))
        math_result = math.sqrt(float(a))
        difference = abs(my_result - math_result)

        print(
            f"{a:.1f}\t"
            f"{my_result:.12f}\t"
            f"{math_result:.12f}\t"
            f"{difference:.12g}"
        )


