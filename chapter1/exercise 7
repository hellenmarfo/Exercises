# eval_loop
# ============================================================

def eval_loop():
    """Continuously evaluate expressions until the user enters 'done'."""

    last_result = None

    while True:
        user_input = input("Enter an expression (or 'done' to quit): ")

        if user_input == "done":
            return last_result

        try:
            last_result = eval(user_input)
            print(last_result)
        except Exception as error:
            print("Error:", error)


