# Exercise 7-3
# Estimate Pi using Ramanujan's Infinite Series
# ============================================================

def estimate_pi():
    """Estimate pi using Ramanujan's infinite series."""

    import math

    total = 0
    k = 0

    while True:
        numerator = math.factorial(4 * k) * (1103 + 26390 * k)
        denominator = (
            math.factorial(k) ** 4
            * 396 ** (4 * k)
        )

        term = numerator / denominator
        total += term

        if term < 1e-15:
            break

        k += 1

    pi_estimate = 1 / ((2 * math.sqrt(2) / 9801) * total)

    return pi_estimate


